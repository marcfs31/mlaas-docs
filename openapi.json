{
  "components": {
    "securitySchemes": {
      "apiKey": {
        "description": "Generated on first start and kept in data/api_key.",
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Register a dataset and a model spec, train, and call predict. Every prediction is logged; post real outcomes to /feedback. A loop checks each model on a schedule and, when enough new labels arrive, the live score drops, inputs drift, or a timer elapses, trains a challenger and promotes it only if it beats the champion on the same holdout.\n\nEvery call needs an `X-API-Key` header except where marked otherwise. This document is generated from the running build's own route table, so its version is the version answering.",
    "summary": "A local model service that retrains itself.",
    "title": "mlaas",
    "version": "v1.8.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/catalog": {
      "get": {
        "operationId": "getCatalog",
        "responses": {
          "200": {
            "description": "the call succeeded"
          },
          "401": {
            "description": "missing or wrong X-API-Key"
          }
        },
        "summary": "public datasets that can be fetched by name, with their licences",
        "tags": [
          "Datasets"
        ],
        "x-codeSamples": [
          {
            "label": "curl",
            "lang": "Shell",
            "source": "curl -s -H \"X-API-Key: {key}\" {base}/catalog"
